{% comment %}
  Uses GitHub's own social-preview image service instead of the (currently down)
  github-readme-stats.vercel.app pin API, so cards keep rendering regardless of
  that third-party service's uptime.
{% endcomment %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}">
    <img
      class="w-100 rounded"
      alt="{{ include.repository }}"
      src="https://opengraph.githubassets.com/1/{{ include.repository }}"
    >
  </a>
</div>
